export PATH="$HOME/.local/bin:$PATH"

## history
HISTFILE=$HOME/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt share_history
setopt hist_ignore_all_dups

## navigation
setopt auto_cd

## completions
autoload -Uz compinit
compinit

## evals (after compinit)
eval "$(sheldon source)"
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
eval "$(direnv hook zsh)"
eval "$(mise activate zsh)"

## orbstack (PATH fallback if /usr/local/bin links are missing)
source ~/.orbstack/shell/init.zsh 2>/dev/null || :

## aliases
alias ls="eza --icons"
alias la="eza --icons -a --git -g -h --oneline"
alias ll="eza --icons -l --git -h"
alias lla="eza --icons -la --git -h"

## fzf history search (^r)
function fzf-select-history() {
    BUFFER=$(history -n -r 1 | fzf --query "$LBUFFER")
    CURSOR=$#BUFFER
    zle reset-prompt
}
zle -N fzf-select-history
bindkey '^r' fzf-select-history

## claude (Remote Control のセッション名にリポジトリ名を入れる)
function claude() {
    local root
    root=$(command git rev-parse --show-toplevel 2>/dev/null) || root=$PWD
    CLAUDE_REMOTE_CONTROL_SESSION_NAME_PREFIX=${root:t} command claude "$@"
}

## claude-ds (モデルを DeepSeek に差し替えて Claude Code を起動する)
## キーは 1Password に置き、起動のたびに op で読む。このファイルには書かない
## 設定値は https://api-docs.deepseek.com/quick_start/agent_integrations/claude_code に合わせている
function claude-ds() {
    local ref='op://Private/DeepSeek/credential'
    local key
    key=$(op read --no-newline "$ref") || {
        echo "1Password から $ref を読めませんでした" >&2
        return 1
    }
    (
        export ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
        export ANTHROPIC_AUTH_TOKEN=$key
        export ANTHROPIC_MODEL='deepseek-flash[1m]'
        export ANTHROPIC_DEFAULT_OPUS_MODEL='deepseek-flash[1m]'
        export ANTHROPIC_DEFAULT_SONNET_MODEL='deepseek-flash[1m]'
        export ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-flash
        export CLAUDE_CODE_SUBAGENT_MODEL=deepseek-flash
        export CLAUDE_CODE_EFFORT_LEVEL=max
        export CLAUDE_CODE_AUTO_COMPACT_WINDOW=786432
        export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
        claude "$@"
    )
}

